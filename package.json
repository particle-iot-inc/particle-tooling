{
	"name": "@particle/tooling",
	"version": "0.1.3",
	"description": "Shared oxlint, oxfmt and TypeScript configuration for Particle projects",
	"homepage": "https://github.com/particle-iot-inc/particle-tooling",
	"bugs": {
		"url": "https://github.com/particle-iot-inc/particle-tooling/issues"
	},
	"license": "ISC",
	"author": "",
	"repository": {
		"type": "git",
		"url": "https://github.com/particle-iot-inc/particle-tooling.git"
	},
	"bin": {
		"particle-tooling-init": "bin/init.js"
	},
	"files": [
		"bin/init.js",
		"lib",
		"oxfmt.d.ts",
		"oxfmt.js",
		"oxlint-typescript.d.ts",
		"oxlint-typescript.js",
		"oxlint.d.ts",
		"oxlint.js",
		"tsconfig"
	],
	"type": "module",
	"exports": {
		"./oxlint": {
			"types": "./oxlint.d.ts",
			"default": "./oxlint.js"
		},
		"./oxlint-typescript": {
			"types": "./oxlint-typescript.d.ts",
			"default": "./oxlint-typescript.js"
		},
		"./oxfmt": {
			"types": "./oxfmt.d.ts",
			"default": "./oxfmt.js"
		},
		"./tsconfig/*.json": "./tsconfig/*.json"
	},
	"publishConfig": {
		"access": "restricted"
	},
	"scripts": {
		"check": "oxlint --deny-warnings && oxfmt --check",
		"fmt": "oxfmt",
		"test": "vitest run"
	},
	"devDependencies": {
		"oxfmt": "~0.78.0",
		"oxlint": "^1.93.0",
		"oxlint-tsgolint": "^7.0.2007",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	},
	"peerDependencies": {
		"oxfmt": "~0.78.0",
		"oxlint": "^1.93.0",
		"oxlint-tsgolint": "^7.0.2007",
		"typescript": "^7.0.2"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=22.23.4",
		"npm": ">=10"
	}
}
